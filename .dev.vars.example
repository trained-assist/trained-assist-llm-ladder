# Local secrets for `npm run dev` (wrangler dev). Copy to .dev.vars — it is gitignored.
# Never commit real values; the committed example keeps placeholders only.
#
#   cp .dev.vars.example .dev.vars
#
# LADDER_TOKEN — whatever you want local clients to send; pick any value and point clients at
# http://localhost:8787 with the same value.
LADDER_TOKEN=local-dev
# Upstream keys — copy from the worker secrets (wrangler secret list / your password manager).
OPENCODE_GO_API_KEYS=oc_xxx,oc_yyy
OPENROUTER_API_KEY=sk-or-xxx

# ZeroCreds connect flow (#53). Point ZEROCREDS_BASE_URL at a local zerocreds-server
# (PORT=3456 npm start in its repo) when developing offline.
ZEROCREDS_BASE_URL=https://zerocreds.ru
# Optional: admin token of that zerocreds-server (same value as its ZEROCREDS_ADMIN_TOKEN).
# Leave empty while the server runs with auth disabled — the header is then not sent at all.
ZEROCREDS_ADMIN_TOKEN=
# Shared secret the worker puts in the webhook Authorization header; zerocreds POSTs here.
ZC_WEBHOOK_TOKEN=wh_local
# 32 bytes, base64 or hex: `openssl rand -base64 32`. Encrypts KV blobs at rest.
CREDS_ENC_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
