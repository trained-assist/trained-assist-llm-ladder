{
  "name": "trained-assist-llm-ladder",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "OpenAI-compatible model ladder (OpenCode Go → OpenRouter last) for trained-assist service LLM calls — Cloudflare Worker",
  "scripts": {
    "diagnose": "node scripts/diagnose-failure.mjs",
    "test": "node --test test/*.test.js",
    "test:sandbox": "bash scripts/sandbox/sticky-rung.sh",
    "gate": "node scripts/live-gate.mjs",
    "collect": "node scripts/collect-free-models.mjs",
    "sync-opencode": "node scripts/sync-opencode-ladder-models.mjs",
    "setup-opencode": "node scripts/setup-opencode-ladder.mjs",
    "zen": "node scripts/zen-pool-client.mjs",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "^4.86.0"
  }
}
